<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground (108 x 108 dp canvas). Launchers mask the canvas, so everything that must stay
  visible lives inside the central 66 dp circle: the capsule is 60 dp long measured along its diagonal.

  Design: a capsule (pill) tilted 45 degrees. One half is white, the other half mint with a teal medical
  cross, on the teal background defined by @color/ic_launcher_background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-45">

        <!-- Left half of the capsule (white). -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M37,41 H54 V67 H37 A13,13 0 0 1 37,41 Z" />

        <!-- Right half of the capsule (mint). -->
        <path
            android:fillColor="#FFA7F3D0"
            android:pathData="M54,41 H71 A13,13 0 0 1 71,67 H54 Z" />

        <!-- Medical cross on the mint half (teal, same as the background). -->
        <path
            android:fillColor="#FF0F766E"
            android:pathData="M66.5,47 H71.5 V51.5 H76 V56.5 H71.5 V61 H66.5 V56.5 H62 V51.5 H66.5 Z" />
    </group>
</vector>
